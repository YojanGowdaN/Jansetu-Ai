{
  "name": "jansetu-ai",
  "version": "1.0.0",
  "description": "JanSetu AI — Digital Public Infrastructure for Citizen Civic Development Intelligence",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix whatsapp-bot install",
    "postinstall": "npm --prefix whatsapp-bot install",
    "start:backend": "cd backend && npm start",
    "start:public": "cd public-web && npm start",
    "start:authority": "cd authority-web && npm start",
    "start:bot": "cd whatsapp-bot && npm start",
    "dev:backend": "cd backend && npm run dev",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.14.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
