# ==============================================================================
# JANSETU AI — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Google Gemini AI API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Firebase / Firestore Configuration
FIREBASE_PROJECT_ID=jansetu-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jansetu-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://jansetu-ai-prod.firebaseio.com

# WhatsApp Bot Integration
WHATSAPP_BOT_PORT=3001
WHATSAPP_SESSION_PATH=./.wwebjs_auth
WHATSAPP_BOT_NUMBER=+916361163002

# Google Maps API Key (Heatmaps & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Next.js App URLs
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
PUBLIC_WEB_URL=http://localhost:3000
AUTHORITY_WEB_URL=http://localhost:3002

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# ==============================================================================
# NITI Aayog API Integration
# Configure these to enable live NITI Aayog data retrieval.
# Without these, JanSetu uses cached/demonstration dataset.
# ==============================================================================
NITI_API_BASE_URL=
NITI_API_KEY=
NITI_API_TIMEOUT_MS=10000

# ==============================================================================
# Government Administrative Boundary Service
# Configure these to enable live administrative boundary resolution.
# Without these, JanSetu uses OpenStreetMap Nominatim + Karnataka fallback.
# ==============================================================================
GEO_BOUNDARY_API_URL=
GEO_BOUNDARY_API_KEY=
LGD_API_URL=

# ==============================================================================
# Audio Processing Configuration
# Maximum audio file size in bytes (default: 25MB)
# ==============================================================================
AUDIO_MAX_SIZE_BYTES=26214400
