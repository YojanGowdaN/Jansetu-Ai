# ─────────────────────────────────────────────────────────
#  Sentinel WhatsApp Bot — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Port for the Express API server
PORT=3001

# URL of your Sentinel AI backend (fake news analysis API)
SENTINEL_API_URL=http://localhost:5000

# Secret used to authenticate internal alert calls
ALERT_SECRET=your_super_secret_key_here

# Confidence threshold above which authority is auto-alerted (0-100)
FAKE_CONFIDENCE_THRESHOLD=90

# Rate limit: max messages per sender per minute
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Cache TTL in milliseconds (default: 10 minutes)
CACHE_TTL_MS=600000

# Your WhatsApp phone number to link the bot (country code + number, no + or spaces)
# Example: India +91 98765 43210  →  WHATSAPP_PHONE=919876543210
# Example: USA  +1  555 123 4567  →  WHATSAPP_PHONE=15551234567
WHATSAPP_PHONE=

# Node environment
NODE_ENV=development
